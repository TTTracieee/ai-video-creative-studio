DATABASE_URL="file:./studio.db"
STORYBOARD_PROVIDER="mock"
VIDEO_PROVIDER="mock"
# Real video: wan3.0 (480p, 2-30s), wan2.2 (480p, 5s) or wan2.6 (720p, 2-15s).
# Lower-cost option: STORYBOARD_PROVIDER=qwen. Copy the base URL from your workspace.
DASHSCOPE_API_KEY=""
# Wan 3.0 requires https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Copy the real API Host from Workspace settings; do not use the placeholder literally.
DASHSCOPE_BASE_URL=""
DASHSCOPE_MODEL="qwen3.8-flash"
# Required only for STORYBOARD_PROVIDER=openai. Choose a Structured Outputs capable model.
OPENAI_API_KEY=""
OPENAI_MODEL=""
# Legacy BACH v1 only; live availability is not verified.
BACH_ACCESS_KEY=""
BACH_SECRET_KEY=""
# Required together for password protection; mandatory when NODE_ENV=production.
APP_PASSWORD=""
SESSION_SECRET=""

NEXT_TELEMETRY_DISABLED=1

CHECKPOINT_DISABLE=1
# Optional local first-cut storage and tool locations. Never put private media in public/.
MEDIA_ROOT=".local-media"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
# Enables deterministic test generation controls; hidden from the normal workspace.
ENABLE_DEV_TOOLS="false"
